export default {
  async fetch(request) {

    const matches = [
      {
        id: 1,
        league: "FIFA World Cup 2026",
        team1: "Mexico",
        team2: "South Africa",
        venue: "Mexico City",
        start_time: "2026-06-11T13:00:00Z",
        duration: 2
      },
      {
        id: 2,
        league: "FIFA World Cup 2026",
        team1: "South Korea",
        team2: "Czech Republic",
        venue: "Guadalajara",
        start_time: "2026-06-11T20:00:00Z",
        duration: 2
      },
      {
        id: 3,
        league: "FIFA World Cup 2026",
        team1: "Canada",
        team2: "Switzerland",
        venue: "Toronto",
        start_time: "2026-06-12T15:00:00Z",
        duration: 2
      }
    ];

    const now = new Date();

    const updatedMatches = matches.map(m => {

      const start = new Date(m.start_time);
      const end = new Date(start.getTime() + (m.duration * 60 * 60 * 1000));

      let status = "UPCOMING";
      let time_left = null;

      if (now >= start && now <= end) {
        status = "LIVE";
      } 
      else if (now > end) {
        status = "FINISHED";
      } 
      else {
        const diff = start - now;
        const mins = Math.floor(diff / 60000);
        time_left = mins > 0 ? mins + " min" : "soon";
      }

      return {
        ...m,
        status,
        time_left
      };
    });

    return new Response(JSON.stringify({
      success: true,
      total_matches: updatedMatches.length,
      matches: updatedMatches
    }), {
      headers: {
        "content-type": "application/json",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    });
  }
};
